generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  DISTRIBUTOR
  SALESMAN
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(DISTRIBUTOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BusinessSetting {
  id            String   @id @default("default")
  businessName  String
  gstin         String?
  address       String?
  phone         String?
  state         String?
  invoicePrefix String   @default("INV")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Product {
  id                 String   @id @default(uuid())
  code               String   @unique
  name               String
  category           String?
  basePrice          Decimal  @db.Decimal(12, 2)
  defaultSellingRate Decimal  @db.Decimal(12, 2)
  mrp                Decimal  @db.Decimal(12, 2)
  gstRate            Decimal  @db.Decimal(5, 2)
  hsnCode            String?
  unit               String   @default("PCS")
  unitsPerCarton     Int?
  pieceWeightGrams   Decimal? @db.Decimal(12, 3)
  caseWeightKg       Decimal? @db.Decimal(12, 6)
  purchaseGstRate    Decimal? @db.Decimal(5, 2)
  minStock           Decimal  @default(0) @db.Decimal(12, 3)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  retailerPrices       RetailerProductPrice[]
  purchaseItems        PurchaseItem[]
  invoiceItems         InvoiceItem[]
  inventoryTransactions InventoryTransaction[]
}

model Beat {
  address String?
  state String?
  city String?
  stateId String?
  cityId String?
  locationState LocationState? @relation(fields: [stateId], references: [id])
  locationCity LocationCity? @relation(fields: [cityId], references: [id])
  id String @id @default(uuid())
  name String @unique
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  retailers Retailer[]
  salesmen SalesmanBeat[]
}

model Salesman {
  id String @id @default(uuid())
  name String
  phone String?
  email String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  beats SalesmanBeat[]
}

model SalesmanBeat {
  salesmanId String
  beatId String
  salesman Salesman @relation(fields: [salesmanId], references: [id], onDelete: Cascade)
  beat Beat @relation(fields: [beatId], references: [id], onDelete: Restrict)
  @@id([salesmanId, beatId])
}

model Retailer {
  city String?
  stateId String?
  cityId String?
  locationState LocationState? @relation(fields: [stateId], references: [id])
  locationCity LocationCity? @relation(fields: [cityId], references: [id])
  id                 String   @id @default(uuid())
  code               String   @unique
  name               String
  market             String
  beat               Beat @relation(fields: [market], references: [name], onUpdate: Cascade, onDelete: Restrict)
  gstin              String?
  phone              String?
  address            String?
  state              String?
  openingOutstanding Decimal  @default(0) @db.Decimal(12, 2)
  creditLimit        Decimal? @db.Decimal(12, 2)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  prices   RetailerProductPrice[]
  invoices Invoice[]
  payments Payment[]
}

model RetailerProductPrice {
  id            String   @id @default(uuid())
  retailerId    String
  productId     String
  sellingRate   Decimal  @db.Decimal(12, 2)
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  retailer Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([retailerId, productId])
  @@index([retailerId])
  @@index([productId])
}

model Purchase {
  id            String   @id @default(uuid())
  invoiceNumber String
  supplierName  String?
  purchaseDate  DateTime
  totalAmount   Decimal  @db.Decimal(14, 2)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items PurchaseItem[]

  @@index([purchaseDate])
}

model PurchaseItem {
  id         String  @id @default(uuid())
  purchaseId String
  productId  String
  quantity   Decimal @db.Decimal(12, 3)
  rate       Decimal @db.Decimal(12, 2)
  gstRate    Decimal @db.Decimal(5, 2)
  lineTotal  Decimal @db.Decimal(14, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
}

model Invoice {
  billType                String   @default("GST")
  id                      String   @id @default(uuid())
  invoiceNumber           String   @unique
  retailerId              String
  invoiceDate             DateTime
  paymentMode             String   @default("CREDIT")
  status                  String   @default("OPEN")
  retailerNameSnapshot    String
  retailerCodeSnapshot    String
  retailerGstinSnapshot   String?
  retailerAddressSnapshot String?
  retailerStateSnapshot   String?
  businessNameSnapshot    String
  businessGstinSnapshot   String?
  businessAddressSnapshot String?
  businessPhoneSnapshot   String?
  businessStateSnapshot   String?
  subtotal                Decimal  @db.Decimal(14, 2)
  discount                Decimal  @default(0) @db.Decimal(14, 2)
  taxableAmount           Decimal  @db.Decimal(14, 2)
  cgst                     Decimal  @default(0) @db.Decimal(14, 2)
  sgst                     Decimal  @default(0) @db.Decimal(14, 2)
  igst                     Decimal  @default(0) @db.Decimal(14, 2)
  roundOff                 Decimal  @default(0) @db.Decimal(8, 2)
  grandTotal               Decimal  @db.Decimal(14, 2)
  amountReceived           Decimal  @default(0) @db.Decimal(14, 2)
  balanceDue               Decimal  @default(0) @db.Decimal(14, 2)
  notes                    String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  retailer Retailer     @relation(fields: [retailerId], references: [id])
  items    InvoiceItem[]
  payments Payment[]

  @@index([invoiceDate])
  @@index([retailerId])
}

model InvoiceItem {
  id                  String  @id @default(uuid())
  invoiceId           String
  productId           String
  productCodeSnapshot String
  productNameSnapshot String
  hsnCodeSnapshot     String?
  quantity            Decimal @db.Decimal(12, 3)
  rate                Decimal @db.Decimal(12, 2)
  costRate            Decimal @db.Decimal(12, 2)
  mrpSnapshot         Decimal @db.Decimal(12, 2)
  gstRate             Decimal @db.Decimal(5, 2)
  taxableAmount       Decimal @db.Decimal(14, 2)
  taxAmount           Decimal @db.Decimal(14, 2)
  lineTotal           Decimal @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id          String   @id @default(uuid())
  retailerId  String
  invoiceId   String?
  amount      Decimal  @db.Decimal(14, 2)
  paymentDate DateTime
  method      String   @default("CASH")
  reference   String?
  notes       String?
  createdAt   DateTime @default(now())

  retailer Retailer @relation(fields: [retailerId], references: [id])
  invoice  Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([retailerId])
  @@index([paymentDate])
}

model InventoryTransaction {
  id            String   @id @default(uuid())
  productId     String
  type          String
  quantityChange Decimal @db.Decimal(12, 3)
  unitCost      Decimal? @db.Decimal(12, 2)
  referenceType String?
  referenceId   String?
  note          String?
  transactionDate DateTime @default(now())
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([transactionDate])
}

model ExpenseCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  expenses  Expense[]
}

model Expense {
  id          String   @id @default(uuid())
  categoryId  String
  amount      Decimal  @db.Decimal(14, 2)
  expenseDate DateTime
  description String
  paymentMode String   @default("CASH")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([expenseDate])
}

model LocationState {
  id String @id
  name String @unique
  category String
  cities LocationCity[]
  retailers Retailer[]
  beats Beat[]
}

model LocationCity {
  id String @id
  name String
  stateId String
  state LocationState @relation(fields: [stateId], references: [id])
  retailers Retailer[]
  beats Beat[]
  @@unique([stateId, name])
}

model ImportLog {
  id           String   @id @default(uuid())
  type         String
  fileName     String
  rowsReceived Int
  rowsImported Int
  status       String
  createdAt    DateTime @default(now())
}
